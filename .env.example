# Server Configuration
LISTEN_HOST=0.0.0.0
PORT=8088
GIN_MODE=release
DB_PATH=data/looseleaf.db
SITE_URL=

# Vesper Auth OAuth2 / OIDC Single Sign-On (Leave blank for pure LAN offline claim-code mode)
# Production example: SITE_URL=https://leaf.starryheavens.uk, OIDC_ISSUER=https://auth.starryheavens.uk
OIDC_ENABLED=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_SUB=

# Local Loopback Bridge for Co-located BotHub Service (Strictly restricted to 127.0.0.1 / ::1 without proxy headers)
INTERNAL_BRIDGE_TOKEN=

# Cloudflare R2 Object Storage (Leave blank if not configured; local disk primary storage works out of the box)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_DOMAIN=
R2_PRESIGN_EXPIRES=1800
