# Server Configuration
PORT=8088
GIN_MODE=release
DB_PATH=data/looseleaf.db

# 鉴权说明：管理员母密钥在首次装帧时于欢迎扉页设定，以 SHA-256 哈希存于 SQLite (site_configs.master_passcode)，无需配置环境变量。

# Cloudflare R2 Object Storage (Leave blank if not configured; text entries and bookkeeping work without R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_DOMAIN=
R2_PRESIGN_EXPIRES=1800
